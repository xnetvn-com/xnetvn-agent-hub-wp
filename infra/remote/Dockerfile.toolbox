FROM composer:2.10.3@sha256:af98f42dfff7c68ba8d53c2164fd9fde1087b7d449514baa38c418b1f6bc4bac AS composer
FROM wordpress:cli-2.12.0-php8.2 AS wpcli
FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS node
FROM wordpress:7.1.2-php8.2-apache@sha256:219698abe159253e1faec209a9cd7c9a2bf57abee3d94b9d0b7dcc0efb753816
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
COPY --from=wpcli /usr/local/bin/wp /usr/local/bin/wp
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN apt-get update && apt-get install --yes --no-install-recommends git unzip zip subversion rsync $PHPIZE_DEPS linux-libc-dev \
    && curl --fail --location --output /tmp/xdebug.tgz https://xdebug.org/files/xdebug-3.5.3.tgz \
    && echo 'f073de91bea046106abf4d6071c963ea71e58571df6ce58948ceca89d121cb2d  /tmp/xdebug.tgz' | sha256sum --check \
    && pecl install /tmp/xdebug.tgz \
    && docker-php-ext-enable xdebug \
    && rm /tmp/xdebug.tgz \
    && ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/wp-tests \
    && svn export --quiet https://develop.svn.wordpress.org/tags/6.9/tests/phpunit /opt/wp-tests/6.9 \
    && svn export --quiet https://develop.svn.wordpress.org/tags/7.1.2/tests/phpunit /opt/wp-tests/7.1.2
RUN apt-get update && apt-get install --yes --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY infra/remote/wordpress-extra.php /opt/xnetvn/wordpress-extra.php
COPY src/Support/Cidr.php /opt/xnetvn/Cidr.php
COPY infra/remote/xdebug.ini /usr/local/etc/php/conf.d/xnetvn-coverage.ini
ENTRYPOINT []
